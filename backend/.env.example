NODE_ENV=development
PORT=3000
DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_URI
SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET
FRONTEND_ORIGIN=https://dsa-study-buddy.vercel.app
VERCEL_PREVIEW_ORIGINS=
DATABASE_SSL=true
PGSSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT_PATH=certs/supabase-root-2021-ca.pem
# Or set DATABASE_CA_CERT to a PEM value with literal \\n sequences.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
EMAIL_PROVIDER=development
RESEND_API_KEY=
EMAIL_FROM=DSA Grind <verify@example.com>
EMAIL_VERIFICATION_BASE_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
