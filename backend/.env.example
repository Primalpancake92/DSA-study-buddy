NODE_ENV=development
PORT=3000
DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_URI
SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET
BCRYPT_ROUNDS=12
FRONTEND_ORIGIN=https://dsa-study-buddy.vercel.app
VERCEL_PREVIEW_ORIGINS=
DATABASE_SSL=true
PGSSL_REJECT_UNAUTHORIZED=true
DATABASE_CA_CERT_PATH=certs/supabase-root-2021-ca.pem
# Or set DATABASE_CA_CERT to a PEM value with literal \\n sequences.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
EMAIL_PROVIDER=development
RESEND_API_KEY=
# Optional AI tutor. Backend ONLY: never put these keys in Vercel/VITE_ variables.
AI_TUTOR_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TUTOR_DAILY_REQUEST_LIMIT=30
TUTOR_RETENTION_DAYS=30
TUTOR_MAX_INPUT_TOKENS=8000
TUTOR_MAX_OUTPUT_TOKENS=1200
EMAIL_FROM=DSA Grind <verify@example.com>
EMAIL_VERIFICATION_BASE_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
# Render production overrides (backend only; never VITE_ variables):
# NODE_ENV=production
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM=DSA Grind <verify@your-verified-domain.com>
# EMAIL_VERIFICATION_BASE_URL=https://dsa-study-buddy.vercel.app/verify-email
